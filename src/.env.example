# Nusxa oling:  cp src/.env.example src/.env   va qiymatlarni o'zgartiring.
# .env faylini GitHub'ga YUBORMANG (.gitignore da bor).

# --- Django ---
# Kalit yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174
# Faqat HTTPS sozlangan serverda (DEBUG=False bilan) True qiling
SECURE_SSL_REDIRECT=False

# --- Postgres (Django ulanishi) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=terminal_db
DB_USER=terminal_user
DB_PASSWORD=bu-yerga-baza-paroli
DB_HOST=db            # Docker'da: db.  Lokalda: 127.0.0.1
DB_PORT=5432

# --- Postgres konteyneri (DB_* bilan bir xil bo'lishi shart) ---
POSTGRES_DB=terminal_db
POSTGRES_USER=terminal_user
POSTGRES_PASSWORD=bu-yerga-baza-paroli

# --- Redis (Celery) ---
REDIS_HOST=redis      # Docker'da: redis.  Lokalda: 127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=bu-yerga-redis-paroli
